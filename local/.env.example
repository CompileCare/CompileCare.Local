# Local-only settings. Copy to local/.env; never commit real values.
OIDC_AUTHORITY=http://keycloak.localhost:8082/realms/compilecare
OIDC_AUDIENCE=compilecare-api
OIDC_CLIENT_ID=compilecare-web
OIDC_SCOPE=openid profile
OIDC_REQUIRE_HTTPS_METADATA=false

# Local-only Keycloak administrator password placeholder; the launcher generates a unique random value.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-secret

# Local-only PostgreSQL password placeholder; the launcher generates a unique random value.
POSTGRES_PASSWORD=replace-with-a-random-local-secret

# Required for the one-time Development-only platform operator bootstrap endpoint.
# Generate with: openssl rand -hex 32
PLATFORM_BOOTSTRAP_SECRET=replace-with-a-random-64-character-secret

# The launcher normally sets this to the adjacent CompileCare.Web checkout.
COMPILECARE_WEB_PATH=../../CompileCare.Web

# Local-only enforced Web CSP origins. Use bare origins, without paths.
CSP_CONNECT_SRC=http://localhost:8081 http://keycloak.localhost:8082
CSP_FRAME_SRC=http://keycloak.localhost:8082
# HTTP CSP origins are permitted only for this local-development environment.
ALLOW_INSECURE_CSP_ORIGINS=true
