# Local environment settings. Copy to local/.env; never commit real values.
OIDC_AUTHORITY=https://your-development-identity-provider.example.com/
OIDC_AUDIENCE=compilecare-api
OIDC_CLIENT_ID=compilecare-web
OIDC_SCOPE=openid profile
OIDC_REQUIRE_HTTPS_METADATA=true

# Used only for this developer's local PostgreSQL container.
POSTGRES_PASSWORD=compilecare-local-only

# The launcher normally sets this to the adjacent CompileCare.Web checkout.
COMPILECARE_WEB_PATH=../CompileCare.Web
